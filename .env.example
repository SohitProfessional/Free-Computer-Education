
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/free_computer_education
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false

# SMTP is required for real password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Free Computer Education <no-reply@example.com>"

# Optional bootstrap admin; create-admin script uses these values.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToALongUniquePassword!
